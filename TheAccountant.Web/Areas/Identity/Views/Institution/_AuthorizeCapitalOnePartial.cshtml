
<div class="authorization-screen theme-aware">
    <button class="back-button" onclick="goBackToSearch()">←</button>

    <div class="institution-header">
        <img id="selectedInstitutionLogo" src="/images/logos/capitalone.png" alt="Capital One" />
        <h3 id="selectedInstitutionName">Capital One</h3>
    </div>

    <p>
        <span id="selectedInstitutionNameInline">Capital One</span> will provide the following standard information to
        <strong>Your App</strong>
    </p>

    <form id="authorizationForm">
        <div class="form-group">
            <label for="dataTypes">Data Access:</label>
            <select id="dataTypes" name="dataTypes" class="form-control">
                <option value="accounts">Accounts</option>
                <option value="transactions">Transactions</option>
            </select>
        </div>

        <div class="form-group legal">
            <p>
                By clicking <strong>“Continue,”</strong> you...
                <ul>
                    <li>
                        Allow <span id="institutionLegalName">Capital One</span> to release your data to <strong>Your App</strong>.
                    </li>
                    <li>
                        Agree to our <a href="/terms" target="_blank">Terms of Use</a>.
                    </li>
                </ul>
            </p>
        </div>

        <button type="submit" class="btn btn-primary">Continue</button>
    </form>
</div>
