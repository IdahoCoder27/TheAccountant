@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    Layout = null;
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Dashboard - @ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/site-theme.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body class="d-flex flex-column min-vh-100 @ViewData["Theme"]">
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Identity/Dashboard">The Accountant™</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarCollapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/Identity/Dashboard/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Identity/Dashboard/Reports">Reports</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Identity/Dashboard/Payments">Payments</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Identity/Dashboard/Users">Users</a></li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item align-self-center px-2">Welcome, @user?.UserName</li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                        </form>
                    </li>
                    <li>
                        <button id="themeToggle" class="btn btn-sm btn-outline-light me-3">🌓</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Dashboard Layout -->
    <div class="container-fluid flex-grow-1 mt-4">
        <div class="row">
            <!-- Sidebar -->
            <aside class="col-md-3 col-lg-2 d-none d-md-block border-end shadow-sm glass-panel">
                <div class="p-3">
                    <h6 class="text-muted">Navigation</h6>
                    <ul class="nav nav-pills flex-column">
                        <li class="nav-item"><a class="nav-link" href="/Identity/Dashboard/Index">Overview</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Identity/Dashboard/Transactions">Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" href="Identity/Institutions/Add">+ Add Institution</a></li>
                        <li class="nav-item"><a class="nav-link" href="Identity/TransactionImport/Upload">Import Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Identity/Dashboard/Settings">Settings</a></li>
                    </ul>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="col-md-9 col-lg-10 px-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-light text-center py-3 mt-auto">
        <small>© @DateTime.Now.Year — The Accountant™</small>
    </footer>

    <div id="institutionPanel" class="glass panel institution-panel">
        <div id="institutionContent">
            <!-- AJAX content loads here -->
        </div>
    </div>

    <div id="import-modal-container" style="display:none;">
        <div id="import-content"></div>
        <!-- AJAX content loads here -->
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<script>
    const toggleBtn = document.getElementById('themeToggle');
    const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    const storedTheme = localStorage.getItem('theme');
    const useDark = storedTheme === 'dark' || (!storedTheme && prefersDark);

    if (useDark) document.body.classList.add('dark-mode');

    toggleBtn.addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      localStorage.setItem('theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');
    });

    $(document).ready(function () {
      console.log("Script loaded");

      $('#addInstitutionButton').on('click', function () {
        console.log("Button clicked");

        // Load the partial view into the content container
        $('#institutionContent').load('/Identity/Institution/AddPartial?area=Identity', function (response, status, xhr) {
          if (status === "error") {
            console.error("Failed to load partial:", xhr.status, xhr.statusText);
          } else {
            console.log("Partial loaded successfully");

            // Then show the panel
            $('#institutionPanel').removeClass('d-none');
            $('#institutionPanel').addClass('show');
            initInstitutionSearch();
          }
        });
      });

      $('#import-button').on('click', function () {
            $.get('/Dashboard?handler=LoadImportView', function (data) {
                $('#import-content').html(data);
                $('#import-modal-container').slideDown(); // Or use a modal/fade
            });
        });

      // Optional: global handler to close the panel if cancel button exists inside partial
      $(document).on('click', '#closeInstitutionPanel', function () {
        $('#institutionPanel').removeClass('show');
      });

        $('#themeToggle').on('click', function () {
            const body = $('body');
            if (body.hasClass('theme-dark')) {
                body.removeClass('theme-dark').addClass('theme-light');
                localStorage.setItem('theme', 'light');
            } else {
                body.removeClass('theme-light').addClass('theme-dark');
                localStorage.setItem('theme', 'dark');
            }
        });

        const savedTheme = localStorage.getItem('theme') || 'dark';
        $('body').removeClass('theme-dark theme-light').addClass(`theme-${savedTheme}`);

        $(document).on('click', '.institution-logo', function (e) {
            e.preventDefault();
            const institution = $(this).data('institution');

            $.ajax({
                url: `/Identity/Institution/AuthorizeInstitution?institution=${institution}`,
                method: 'GET',
                success: function (html) {
                    $('#institutionContent').html(html);
                },
                error: function () {
                    $('#institutionContent').html('<p>Error loading authorization screen. Please try again.</p>');
                }
            });
        });
    });

    const institutions = [
      { name: "Chase", logo: "/images/logos/Chase.png", id: "chase" },
      { name: "Capital One", logo: "/images/logos/CapitalOne.png", id: "capitalone" },
      { name: "Bank of America", logo: "/images/logos/BofA.png", id: "bofa" },
      { name: "Idaho Cental Credit Union", logo: "/images/logos/ICCU.png", id: "iccu" }
    ];


    const input = document.getElementById('institutionSearch');
    const suggestionBox = document.getElementById('institutionSuggestions');

    function initInstitutionSearch() {
      const input = document.getElementById('institutionSearch');
      const suggestionBox = document.getElementById('institutionSuggestions');

      if (!input || !suggestionBox) return;

      function renderSuggestions(filter = '') {
        suggestionBox.innerHTML = '';

        const matches = institutions.filter(i =>
          i.name.toLowerCase().includes(filter.toLowerCase())
        );

        matches.forEach(inst => {
          const div = document.createElement('div');
          div.classList.add('suggestion-item');
          div.innerHTML = `<img src="${inst.logo}" alt="${inst.name}" /><span>${inst.name}</span>`;
          div.addEventListener('click', () => {
            input.value = inst.name;
            suggestionBox.innerHTML = '';
          });
          suggestionBox.appendChild(div);
        });
      }

      input.addEventListener('input', () => {
        renderSuggestions(input.value);
      });

      input.addEventListener('focus', () => {
        renderSuggestions(input.value);
      });

    document.querySelectorAll('.suggestion-item').forEach(item => {
        item.addEventListener('click', () => {
            const institution = item.getAttribute('data-name');
            // Transition to the next step with `institution`
            showAuthorizationForm(institution);
        });
    });

      renderSuggestions(); // optional: show all on load
    }

    function showAuthorizationForm(institution) {
        // Populate values dynamically
        document.getElementById("selectedInstitutionLogo").src = `/images/institutions/${institution.logo}`;
        document.getElementById("selectedInstitutionName").textContent = institution.name;
        document.getElementById("selectedInstitutionNameInline").textContent = institution.name;
        document.getElementById("institutionLegalName").textContent = institution.name;

        // Hide the search screen and show authorization screen
        document.querySelector(".institution-form").style.display = "none";
        document.querySelector(".authorization-screen").style.display = "block";
    }

    function goBackToSearch() {
        document.querySelector(".authorization-screen").style.display = "none";
        document.querySelector(".institution-form").style.display = "block";
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".institution-logo").forEach(button => {
            button.addEventListener("click", function () {
                const institution = button.getAttribute("data-institution");

                fetch(`/Institution/AuthorizeInstitution?institution=${encodeURIComponent(institution)}`)
                    .then(res => {
                        if (!res.ok) throw new Error("Network error");
                        return res.text();
                    })
                    .then(html => {
                        document.getElementById("institutionContent").innerHTML = html;
                    })
                    .catch(err => {
                        console.error("Authorization load failed:", err);
                        // Optional: fallback navigation
                        window.location.href = `/Institution/Authorize?institution=${institution}`;
                    });
            });
        });
    });

</script>

