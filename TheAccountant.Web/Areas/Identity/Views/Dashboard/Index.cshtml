@model TheAccountant.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<section class="container py-4">
    <h1 class="mb-4 fw-bold">Welcome Back</h1>

    <div class="row mb-4">
        @foreach (var account in Model.Accounts)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@account.Institution</h5>
                        <p class="mb-1 text-muted">@account.AccountName</p>
                        <p class="fs-4 fw-semibold">@account.Balance.ToString("C")</p>
                        <small class="text-muted">Updated @account.LastUpdated.ToShortDateString()</small>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row">
        <div class="col-lg-8">
            <h4>Recent Transactions</h4>
            <table class="table table-hover table-sm">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.Transactions)
                    {
                        <tr>
                            <td>@tx.Date.ToShortDateString()</td>
                            <td>@tx.Description</td>
                            <td class="text-end">
                                <span class="@(tx.Amount < 0 ? "text-theme-danger" : "text-theme-success")">
                                    @tx.Amount.ToString("C")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-lg-4">
            <h4>Recurring Payments</h4>
            <ul class="list-group list-group-flush">
                @foreach (var r in Model.RecurringPayments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@r.Name</strong><br />
                            <small class="text-theme-muted">
                                @r.Frequency – due @r.NextDue.ToShortDateString()
                            </small>
                        </div>
                        <span class="badge bg-theme-highlight text-theme-badge">
                            @r.Amount.ToString("C")
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>

</section>
