@model TheAccountant.Web.Models.ViewModels.ImportPreviewViewModel

@{
    ViewData["Title"] = "Import Preview";
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger mt-3">
        @error
    </div>
}

<div class="account-form-page">

    <div class="account-form-header">
        <div>
            <h2 class="section-title">
                Import Preview
            </h2>

            <p class="section-subtitle">
                @Model.FileName → @Model.AccountName
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="glass-card p-3">
                <div class="text-secondary small">
                    Total Rows
                </div>

                <div class="fs-3 fw-semibold">
                    @Model.TotalRows
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="glass-card p-3">
                <div class="text-secondary small">
                    Ready to Import
                </div>

                <div class="fs-3 fw-semibold text-success">
                    @Model.ValidRows
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="glass-card p-3">
                <div class="text-secondary small">
                    Duplicates
                </div>

                <div class="fs-3 fw-semibold text-warning">
                    @Model.DuplicateRows
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="glass-card p-3">
                <div class="text-secondary small">
                    Invalid
                </div>

                <div class="fs-3 fw-semibold text-danger">
                    @Model.InvalidRows
                </div>
            </div>
        </div>

    </div>

    <div class="glass-card p-3">

        <div class="table-responsive">

            <table class="import-preview-table">

                <thead>
                    <tr>
                        <th>Row</th>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th class="text-end">
                            Amount
                        </th>
                        <th class="text-end">
                            Balance
                        </th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                @row.RowNumber
                            </td>

                            <td>
                                @(row.Date?.ToString("MM/dd/yyyy")
                                    ?? "—")
                            </td>

                            <td>
                                @row.Description
                            </td>

                            <td>
                                @row.TransactionType
                            </td>

                            <td class="text-end">
                                @if (row.Amount.HasValue)
                                {
                                    if (row.Amount.Value < 0)
                                    {
                                        <span class="text-danger">
                                            @($"({Math.Abs(row.Amount.Value):C})")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success">
                                            @($"{row.Amount.Value:C}")
                                        </span>
                                    }
                                }
                            </td>

                            <td class="text-end">
                                @(row.Balance?.ToString("C")
                                    ?? "—")
                            </td>

                            <td>

                                @if (!row.IsValid)
                                {
                                    <span class="badge bg-danger">
                                        Invalid
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(row.ValidationError))
                                    {
                                        <div class="small text-danger mt-1">
                                            @row.ValidationError
                                        </div>
                                    }
                                }
                                else if (row.IsDuplicate)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Duplicate
                                    </span>
                                }
                                else if (row.IsPending)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        New
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <div class="d-flex justify-content-between align-items-center mt-4">

                <a asp-controller="Import"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>

                @if (Model.ValidRows > 0)
                {
                    <form asp-controller="Import"
                          asp-action="Confirm"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.BatchId" />

                        <button type="submit"
                                class="btn btn-account-primary">
                            Import @Model.ValidRows Transactions
                        </button>

                    </form>
                }

            </div>

        </div>

    </div>

</div>