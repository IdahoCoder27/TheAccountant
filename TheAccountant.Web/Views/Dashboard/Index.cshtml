@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-5">
    <h2 class="mb-4">Welcome back, @User.Identity.Name</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">Total Balance</h5>
                    <p class="display-6">$12,480.22</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">Spending This Month</h5>
                    <p class="display-6 text-danger">$2,614.90</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Recurring</h5>
                    <p class="display-6">$329.50</p>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <h4>Recent Transactions</h4>
    <!-- Placeholder for transactions -->
    <ul class="list-group">
        <li class="list-group-item d-flex justify-content-between">
            Netflix Subscription <span class="text-danger">- $15.49</span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
            Paycheck <span class="text-success">+ $3,200.00</span>
        </li>
    </ul>
</div>
