@model TheAccountant.Web.Models.ViewModels.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-grid">

    <section class="metric-card glass-card">
        <div class="metric-label">Net Worth</div>
        <div class="metric-value">
            @Model.NetWorth.ToString("C")
        </div>
        <div class="metric-change positive">
            +4.8% this month
        </div>
    </section>

    <section class="metric-card glass-card">
        <div class="metric-label">Cash</div>
        <div class="metric-value">
            @Model.CashBalance.ToString("C")
        </div>
        <div class="metric-subtext">
            Across checking and savings
        </div>
    </section>

    <section class="metric-card glass-card">
        <div class="metric-label">Credit Debt</div>
        <div class="metric-value">
            @Model.CreditDebt.ToString("C")
        </div>
        <div class="metric-subtext">
            @Model.ActiveAccountCount active account@(Model.ActiveAccountCount == 1 ? "" : "s")
        </div>
    </section>

    <section class="metric-card glass-card">
        <div class="metric-label">Monthly Spending</div>
        <div class="metric-value">@Model.MonthlySpending.ToString("C")</div>
        <div class="metric-subtext">
            Posted transactions this month
        </div>
    </section>

    <section class="dashboard-panel glass-card chart-panel">
        <div class="panel-header">
            <div>
                <h2>Income vs Spending</h2>
                <p>Last 6 months</p>
            </div>
        </div>

        <div class="cashflow-chart-container">
            <canvas id="cashFlowChart"></canvas>
        </div>
    </section>

    <section class="dashboard-panel glass-card category-panel">
        <div class="panel-header">
            <div>
                <h2>Spending by Category</h2>
                <p>This month</p>
            </div>
        </div>

        <div class="category-list">

            @if (Model.SpendingByCategory.Any())
            {
                @foreach (var category in Model.SpendingByCategory)
                {
                    <div class="category-row">

                        <span>
                            @category.Category
                        </span>

                        <strong>
                            @category.Amount.ToString("C")
                        </strong>

                    </div>
                }
            }
            else
            {
                <div class="dashboard-empty">
                    No posted spending this month.
                </div>
            }

        </div>
    </section>

    <section class="dashboard-panel glass-card accounts-panel">
        <div class="panel-header">
            <div>
                <h2>Accounts</h2>
                <p>Current balances</p>
            </div>

            <a asp-controller="Accounts"
               asp-action="Index"
               class="panel-link">
                Manage accounts
            </a>
        </div>

        <div class="account-list">

            @foreach (var account in Model.Accounts)
            {
                <div class="account-row">

                    <div>
                        <strong>
                            @account.InstitutionName @account.AccountName
                        </strong>

                        <span>
                            @account.AccountType

                            @if (!string.IsNullOrWhiteSpace(account.LastFour))
                            {
                                <text> · •••• @account.LastFour</text>
                            }
                        </span>
                    </div>

                    <strong>
                        @account.CurrentBalance.ToString("C")
                    </strong>

                </div>
            }

        </div>
    </section>

    <section class="dashboard-panel glass-card transactions-panel">
        <div class="panel-header">
            <div>
                <h2>Recent Transactions</h2>
                <p>Latest activity</p>
            </div>

            <a asp-controller="Transactions"
               asp-action="Index"
               class="panel-link">
                View all
            </a>
        </div>

        <div class="transaction-list">

            @if (Model.RecentTransactions.Any())
            {
                @foreach (var transaction in Model.RecentTransactions)
                {
                    <div class="transaction-row">

                        <div>

                            <strong>
                                @(string.IsNullOrWhiteSpace(transaction.Merchant)
                                    ? transaction.Description
                                    : transaction.Merchant)
                            </strong>

                            <span>
                                @(string.IsNullOrWhiteSpace(transaction.Category)
                                    ? "Uncategorized"
                                    : transaction.Category)

                                ·

                                @transaction.Account.InstitutionName
                                @transaction.Account.AccountName

                                @if (transaction.IsPending)
                                {
                                    <text> · Pending</text>
                                }
                            </span>

                        </div>

                        <strong class="@(transaction.Amount >= 0 ? "positive" : "negative")">

                            @(transaction.Amount >= 0
                                ? "+" + transaction.Amount.ToString("C")
                                : transaction.Amount.ToString("C"))

                        </strong>

                    </div>
                }
            }
            else
            {
                <div class="dashboard-empty">
                    No transactions yet.
                </div>
            }

        </div>
    </section>

</div>

@section Scripts {

    <script src="~/lib/chart.js/chart.umd.js"></script>

    <script>
        $(function () {

            const labels = @Html.Raw(
                                            JsonSerializer.Serialize(
                                                    Model.CashFlowHistory.Select(x => x.Month)));

            const incomeData = @Html.Raw(
                                            JsonSerializer.Serialize(
                                                    Model.CashFlowHistory.Select(x => x.Income)));

            const spendingData = @Html.Raw(
                                            JsonSerializer.Serialize(
                                                    Model.CashFlowHistory.Select(x => x.Spending)));

            const canvas =
                document.getElementById("cashFlowChart");

            if (!canvas) {
                return;
            }

            const ctx = canvas.getContext("2d");

            const chart = new Chart(ctx, {
                type: "line",

                data: {
                    labels: labels,

                    datasets: [
                        {
                            label: "Income",
                            data: incomeData,

                            borderColor: "#22c55e",
                            backgroundColor: "rgba(34, 197, 94, .12)",

                            borderWidth: 2,
                            tension: .35,

                            pointRadius: 4,
                            pointHoverRadius: 6,

                            fill: true
                        },
                        {
                            label: "Spending",
                            data: spendingData,

                            borderColor: "#3b82f6",
                            backgroundColor: "rgba(59, 130, 246, .08)",

                            borderWidth: 2,
                            tension: .35,

                            pointRadius: 4,
                            pointHoverRadius: 6,

                            fill: true
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    interaction: {
                        intersect: false,
                        mode: "index"
                    },

                    plugins: {
                        legend: {
                            position: "top",
                            align: "end"
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label +
                                        ": " +
                                        new Intl.NumberFormat(
                                            "en-US",
                                            {
                                                style: "currency",
                                                currency: "USD"
                                            })
                                            .format(context.parsed.y);
                                }
                            }
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,

                            ticks: {
                                callback: function (value) {
                                    return new Intl.NumberFormat(
                                        "en-US",
                                        {
                                            style: "currency",
                                            currency: "USD",
                                            maximumFractionDigits: 0
                                        })
                                        .format(value);
                                }
                            }
                        },

                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });

        });
    </script>
}